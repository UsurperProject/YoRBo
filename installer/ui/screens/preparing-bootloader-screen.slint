import { Theme } from "../theme.slint";
import { StepLayout } from "../components/step-layout.slint";
import { InfoNote } from "../components/info-note.slint";
import { Spinner, IndeterminateBar } from "../components/loaders.slint";

export component PreparingBootloaderScreen inherits Rectangle {
    in property <string> target-path;

    StepLayout {
        heading: "Preparing partition";
        secondary-text: "Please wait";
        secondary-enabled: false;

        HorizontalLayout {
            spacing: 18px;
            padding-top: 8px;
            VerticalLayout { alignment: start; Spinner { size: 40px; } }
            VerticalLayout {
                spacing: 8px;
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: "Writing boot files";
                    color: Theme.text;
                    font-family: Theme.font-sans;
                    font-size: 12px;
                }
                Text {
                    text: root.target-path;
                    color: Theme.text-muted;
                    font-family: Theme.font-mono;
                    font-size: 10px;
                    overflow: elide;
                }
                IndeterminateBar { }
            }
        }

        InfoNote {
            warning: true;
            text: "Don’t restart or power off during this step.";
        }
    }
}
