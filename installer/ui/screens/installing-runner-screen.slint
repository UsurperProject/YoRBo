import { StepLayout } from "../components/step-layout.slint";
import { ProgressBlock } from "../components/progress-block.slint";
import { Spinner } from "../components/loaders.slint";

export component InstallingRunnerScreen inherits Rectangle {
    in property <float> progress;
    in property <string> progress-label: "Copying files";
    in property <string> progress-caption;
    callback cancel();

    StepLayout {
        heading: "Installing runner";
        secondary-text: "Cancel";
        secondary-clicked => { root.cancel(); }

        HorizontalLayout {
            spacing: 18px;
            padding-top: 8px;
            VerticalLayout { alignment: start; Spinner { size: 40px; } }
            ProgressBlock {
                horizontal-stretch: 1;
                label: root.progress-label;
                progress: root.progress;
                caption: root.progress-caption;
            }
        }
    }
}
