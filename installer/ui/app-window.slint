import { Theme } from "theme.slint";
import { Step, PartitionOption, TaskItem } from "types.slint";
import { TitleBar } from "components/title-bar.slint";
import { Sidebar } from "components/sidebar.slint";
import { DiscoverScreen } from "screens/discover-screen.slint";
import { RunnerDirectoryScreen } from "screens/runner-directory-screen.slint";
import { InstallingRunnerScreen } from "screens/installing-runner-screen.slint";
import { BootloaderChoiceScreen } from "screens/bootloader-choice-screen.slint";
import { PreparingBootloaderScreen } from "screens/preparing-bootloader-screen.slint";
import { DownloadingStaticsScreen } from "screens/downloading-statics-screen.slint";
import { PostInstallScreen } from "screens/post-install-screen.slint";
import { CompleteScreen } from "screens/complete-screen.slint";

export { Step, StageState, TaskState, PartitionOption, TaskItem } from "types.slint";

export component AppWindow inherits Window {
    title: "YoRBo Setup";
    no-frame: true;
    background: transparent;
    preferred-width: 640px;
    preferred-height: 460px;
    min-width: 640px;
    min-height: 460px;

    // ── Navigation ────────────────────────────────────────────────
    in-out property <Step> step: Step.scanning;

    // ── Runner ────────────────────────────────────────────────────
    in-out property <string> runner-path: "C:\\Program Files\\YoRBo";
    in property <float> runner-progress: 0;
    in property <string> runner-caption;

    // ── Bootloader destination ────────────────────────────────────
    in-out property <bool> use-existing-partition: true;
    in property <[PartitionOption]> fat32-partitions;
    in property <[PartitionOption]> shrink-partitions;
    in-out property <int> fat32-index: 0;
    in-out property <int> shrink-index: 0;
    in property <string> bootloader-path;

    // ── YoRBo-statics download ────────────────────────────────────
    in property <float> statics-progress: 0;
    in property <string> statics-caption;

    // ── Post-install hooks ────────────────────────────────────────
    in property <[TaskItem]> tasks;

    // ── Actions (implemented by the host) ─────────────────────────
    callback install();
    callback browse-runner();
    callback install-runner();
    callback cancel();
    callback back();
    callback continue-existing(int);
    callback create-partition(int);
    callback finish();

    // ── Window chrome (frameless window) ──────────────────────────
    callback window-minimize();
    callback window-maximize();
    callback window-close();
    callback window-drag(length, length);

    private property <int> stage:
        root.step == Step.scanning || root.step == Step.install-ready ? 0
        : root.step == Step.runner-directory || root.step == Step.installing-runner ? 1
        : root.step == Step.bootloader-choice || root.step == Step.preparing-bootloader
            || root.step == Step.downloading-statics ? 2
        : root.step == Step.post-install ? 3
        : 4;

    Rectangle {
        background: Theme.window-bg;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;

        VerticalLayout {
            TitleBar {
                minimize => { root.window-minimize(); }
                maximize => { root.window-maximize(); }
                close => { root.window-close(); }
                drag-moved(dx, dy) => { root.window-drag(dx, dy); }
            }

            HorizontalLayout {
                Sidebar { current-stage: root.stage; }

                Rectangle {
                    horizontal-stretch: 1;

                    if root.step == Step.scanning || root.step == Step.install-ready: DiscoverScreen {
                        scanning: root.step == Step.scanning;
                        install => { root.install(); }
                        cancel => { root.cancel(); }
                    }
                    if root.step == Step.runner-directory: RunnerDirectoryScreen {
                        path: root.runner-path;
                        browse => { root.browse-runner(); }
                        back => { root.back(); }
                        install => { root.install-runner(); }
                    }
                    if root.step == Step.installing-runner: InstallingRunnerScreen {
                        progress: root.runner-progress;
                        progress-caption: root.runner-caption;
                        cancel => { root.cancel(); }
                    }
                    if root.step == Step.bootloader-choice: BootloaderChoiceScreen {
                        use-existing <=> root.use-existing-partition;
                        fat32-partitions: root.fat32-partitions;
                        shrink-partitions: root.shrink-partitions;
                        fat32-index <=> root.fat32-index;
                        shrink-index <=> root.shrink-index;
                        back => { root.back(); }
                        continue-existing(i) => { root.continue-existing(i); }
                        create-partition(i) => { root.create-partition(i); }
                    }
                    if root.step == Step.preparing-bootloader: PreparingBootloaderScreen {
                        target-path: root.bootloader-path;
                    }
                    if root.step == Step.downloading-statics: DownloadingStaticsScreen {
                        progress: root.statics-progress;
                        progress-caption: root.statics-caption;
                        cancel => { root.cancel(); }
                    }
                    if root.step == Step.post-install: PostInstallScreen {
                        tasks: root.tasks;
                    }
                    if root.step == Step.complete: CompleteScreen {
                        finish => { root.finish(); }
                    }
                }
            }
        }
    }
}
